rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Función auxiliar para verificar si el usuario autenticado es el administrador
    // OPCIÓN RECOMENDADA: Usar Custom Claims (request.auth.token.role == 'admin')
    // Para configurar: https://firebase.google.com/docs/auth/admin/custom-claims
    function isAdmin() {
      // Opción A: Custom Claims (Recomendado)
      // return request.auth != null && request.auth.token.role == 'admin';
      
      // Opción B: Email específico (Reemplaza con tu email de admin)
      return request.auth != null && 
        request.auth.token.email.lower() == 'admin@barberiasistema.com';
    }

    // Permitir acceso público a las jornadas de reserva (necesario para que los clientes puedan reservar turnos)
    match /jornadasReservas/{jornadaId} {
      allow read, write: if true;
    }

    // Opciones del cliente (servicios y precios): lectura pública, edición solo por admin
    match /opcionesCliente/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Barberos: lectura pública (para que los clientes vean quién atiende), escritura solo por admin
    match /barberos/{barberoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Cobros: lectura y creación pública (al reservar turno), pero modificación y borrado por el admin autenticado
    match /cobros/{cobroId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }

    // Proteger todo lo demás (Clientes, Planes, Configuración) exclusivamente para el admin
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
