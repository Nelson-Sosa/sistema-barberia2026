# ============================================================
# VARIABLES DE ENTORNO - FIREBASE
# Proyecto: Barbería Sistema
# ============================================================

# Configuración Firebase
# Obtén estos valores desde Firebase Console > Project Settings
VITE_FIREBASE_API_KEY=tu_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto-id
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=tu_messaging_sender_id
VITE_FIREBASE_APP_ID=tu_app_id

# Email del administrador principal
# Este email tendrá acceso completo al sistema
VITE_ADMIN_EMAIL=admin@barberiasistema.com
